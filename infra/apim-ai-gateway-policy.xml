<!-- APIM inbound policy for the AI gateway: Entra ID auth, per-user token quota,
     managed-identity auth to Azure OpenAI, token metrics for cost dashboards. -->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization" failed-validation-httpcode="401">
      <client-application-ids>
        <application-id>{{copilot-client-app-id}}</application-id>
      </client-application-ids>
    </validate-azure-ad-token>
    <azure-openai-token-limit counter-key="@(context.Request.Headers.GetValueOrDefault("x-user-oid", "anonymous"))"
                              tokens-per-minute="5000" estimate-prompt-tokens="true"
                              remaining-tokens-header-name="x-remaining-tokens" />
    <azure-openai-emit-token-metric namespace="genai-copilot">
      <dimension name="UseCase" value="it-support-copilot" />
      <dimension name="User" value="@(context.Request.Headers.GetValueOrDefault("x-user-oid", "anonymous"))" />
    </azure-openai-emit-token-metric>
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" client-id="{{app-identity-client-id}}" />
    <set-backend-service backend-id="openai-primary" />
  </inbound>
  <backend>
    <!-- Fallback to secondary region on 429/5xx -->
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="1" interval="1" first-fast-retry="true">
      <choose>
        <when condition="@(context.Response != null && (context.Response.StatusCode == 429 || context.Response.StatusCode >= 500))">
          <set-backend-service backend-id="openai-secondary" />
        </when>
      </choose>
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
